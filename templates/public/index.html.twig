{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {# pour afficher des variables, on utilise" {{ var }}, pour effectuer une action on utilise {% action %} #}
    <h1>Salut {{ name }}, <small>tu es sur le contrôleur {{ controller_name }}! ✅</small></h1>
    {# Twig dans Symfony protège par défaut contre les attaques XSS #}
    {{ xss }}
    {# Pour accepter les script on utilise variable|raw #}
    {{ scriptok|raw }}

    {# importation du menu, attention chemain absolu depuis template #}
    {% include 'public/inc/menu.html.twig' %}
    
</div>
{% endblock %}
